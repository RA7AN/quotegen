# .env.example — copy to .env (gitignored) and fill in real values.
# Issue #13 groundwork. `client.ts` treats any URL containing REPLACE_ME as
# "not configured", so the app builds/tests green before Neon creds land.

# Neon Postgres — use the POOLED connection string (endpoint has -pooler).
DATABASE_URL=postgresql://REPLACE_ME:REPLACE_ME@ep-REPLACE_ME-pooler.neon.tech/neondb?sslmode=require
