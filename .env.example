# .env.example — copy to .env (gitignored) and fill in real values.
# Issue #13 groundwork. `client.ts` treats any URL containing REPLACE_ME as
# "not configured", so the app builds/tests green before Neon creds land.

# Neon Postgres — use the POOLED connection string (endpoint has -pooler).
DATABASE_URL=postgresql://REPLACE_ME:REPLACE_ME@ep-REPLACE_ME-pooler.neon.tech/neondb?sslmode=require

# Better Auth (#9). Signing/hashing secret — generate one and keep it private:
#   npx @better-auth/cli generate-secret
# Any value containing REPLACE_ME is treated as "not configured" (app stays green).
BETTER_AUTH_SECRET=REPLACE_ME_generate_with_npx_better-auth_cli_generate-secret
# Public base URL used for auth links. Falls back to NEXT_PUBLIC_SITE_URL then
# http://localhost:3000, so it is optional locally; set it to the Vercel URL in prod.
BETTER_AUTH_URL=https://REPLACE_ME.vercel.app

# Resend SMTP (#9) — password-reset emails. Verify the sender domain (SPF/DKIM) in
# Resend for reliable delivery. A key containing REPLACE_ME is treated as unset.
RESEND_API_KEY=re_REPLACE_ME
EMAIL_FROM="Quotegen <onboarding@resend.dev>"
