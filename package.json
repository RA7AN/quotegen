    "@react-pdf/renderer": "^4.9.0",
    "@tailwindcss/postcss": "^4.3.4",
    "arabic-persian-reshaper": "^1.0.1",
    "better-auth": "^1.7.17",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.37.0",
    "tailwindcss": "^4.3.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "postgres": "^3.4.9",
